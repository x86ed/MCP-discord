# Discord Bot Configuration
# Get your bot token from: https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Optional: Specific guild ID for faster command registration during development
# Leave empty or remove for global commands
DISCORD_GUILD_ID=

# MCP Server Environment Variables
# These are passed to the MCP server process

# Example: API key for weather service (if required by your MCP server)
WEATHER_API_KEY=your_weather_api_key_here

# Example: Log level for the MCP server
LOG_LEVEL=info
