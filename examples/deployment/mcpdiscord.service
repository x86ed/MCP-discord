[Unit]
Description=MCP-Discord Bot
Documentation=https://github.com/yourusername/MCP-discord
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mcpdiscord
Group=mcpdiscord

# Working directory
WorkingDirectory=/etc/mcpdiscord

# Command to execute
ExecStart=/usr/local/bin/mcpdiscord --config /etc/mcpdiscord/config.json

# Environment file with secrets
EnvironmentFile=/etc/mcpdiscord/environment

# Restart policy
Restart=always
RestartSec=10

# Resource limits
LimitNOFILE=4096
MemoryMax=512M

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/mcpdiscord
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mcpdiscord

[Install]
WantedBy=multi-user.target
